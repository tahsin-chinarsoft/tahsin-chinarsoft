  {
   "type": "gauge",
   "title": "OEE",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${DS_INFLUX}"
     },
     "rawSql": "SELECT\n  run_s / (run_s + unplanned_s)                          AS availability,\n  2.0 * parts / run_s                                AS performance,\n  good / parts                                           AS quality,\n  run_s / (run_s + unplanned_s) * 2.0 * parts / run_s * good / parts AS oee\nFROM (\n  SELECT\n    SUM(CASE WHEN bucket = 'run'       THEN dt ELSE 0 END) * 1.0 AS run_s,\n    SUM(CASE WHEN bucket = 'unplanned' THEN dt ELSE 0 END) * 1.0 AS unplanned_s,\n    (MAX(good) - MIN(good) + MAX(scrap) - MIN(scrap)) * 1.0      AS parts,\n    (MAX(good) - MIN(good)) * 1.0                                AS good\n  FROM machine\n  WHERE $__timeFilter(time)\n)",
     "rawQuery": true,
     "format": "table",
     "dataset": "iox",
     "table": "",
     "sql": {}
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1,
     "min": 0,
     "max": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#E5484D",
        "value": null
       },
       {
        "color": "#F28C28",
        "value": 0.6
       },
       {
        "color": "#3FB97E",
        "value": 0.85
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/^oee$/",
     "values": false
    },
    "showThresholdMarkers": true,
    "showThresholdLabels": false,
    "minVizHeight": 75,
    "minVizWidth": 75
   },
