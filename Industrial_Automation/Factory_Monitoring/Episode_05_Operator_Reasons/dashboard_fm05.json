  {
   "type": "barchart",
   "title": "Unplanned downtime by reason \u2013 machine + operator (minutes)",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${DS_INFLUX}"
     },
     "rawSql": "SELECT\n  CASE\n    WHEN op_reason <> ''  THEN op_reason\n    WHEN state = 'IDLE'   THEN 'idle \u2013 waiting for operator'\n    ELSE reason\n  END AS reason,\n  ROUND(SUM(minutes), 1) AS minutes\nFROM stops\nWHERE type = 'unplanned' AND $__timeFilter(time)\nGROUP BY 1\nORDER BY minutes DESC",
     "rawQuery": true,
     "format": "table",
     "dataset": "iox",
     "table": "",
     "sql": {}
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "suffix: min",
     "decimals": 1,
     "color": {
      "mode": "fixed",
      "fixedColor": "#E5484D"
     },
     "custom": {
      "fillOpacity": 85,
      "lineWidth": 0
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "xField": "reason",
    "showValue": "always",
    "barWidth": 0.7,
    "groupWidth": 0.7,
    "legend": {
     "showLegend": false
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "id": 7,
   "gridPos": {
