 {
  "id": "fm020003",
  "type": "function",
  "z": "fm020000",
  "name": "Decode registers",
  "func": "// Holding registers 0..11 from the ChinarSoft virtual machine -> one object\nconst r = msg.payload;\nconst STATES  = ['STOPPED', 'RUNNING', 'IDLE', 'FAULT', 'CHANGEOVER', 'PLANNED_STOP'];\nconst REASONS = ['-', 'material shortage', 'jam', 'motor overload', 'sensor fault',\n                 'changeover', 'break/meal', 'planned maintenance'];\n\nmsg.payload = {\n    state:      STATES[r[0]] ?? `UNKNOWN(${r[0]})`,\n    reason:     REASONS[r[1]] ?? String(r[1]),\n    good:       r[2] * 65536 + r[3],      // 32-bit counter, high word first\n    scrap:      r[4] * 65536 + r[5],\n    idealCycle: r[6] / 10,                // seconds\n    cycle:      r[7] / 10,                // seconds\n    product:    r[8],\n    temp:       r[9] / 10,                // degC\n    heartbeat:  r[10],                    // +1 per machine second\n    inState:    r[11]                     // machine seconds in current state\n};\nreturn msg;\n",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 400,
  "y": 120,
  "wires": [
   [
    "fm020004"
   ]
  ]
 },
 {
  "id": "fm020004",
  "type": "function",
  "z": "fm020000",
  "name": "Detect stops",
  "func": "// Detects every state change and turns each finished stop into one record.\n// Time comes from the machine's own heartbeat (+1 per machine second),\n// so durations stay correct at any simulator --speed.\nconst p = msg.payload;\nconst PLANNED = ['CHANGEOVER', 'PLANNED_STOP'];\nconst bucket = s => s === 'RUNNING' ? 'run' : PLANNED.includes(s) ? 'planned' : 'unplanned';\n\nlet last   = context.get('last');\nlet clock  = context.get('clock')  || 0;                    // machine seconds\nlet totals = context.get('totals') || { run: 0, planned: 0, unplanned: 0 };\nlet log    = context.get('log')    || [];\n\nif (!last) {                                                // first reading\n    clock = p.heartbeat;\n    last  = { state: p.state, reason: p.reason, since: clock - p.inState };\n    totals[bucket(p.state)] += p.inState;\n} else {\n    const dt = (p.heartbeat - last.hb + 65536) % 65536;     // heartbeat wraps at 65535\n    clock += dt;\n    totals[bucket(last.state)] += dt;\n}\n\nconst hhmm = s => String(Math.floor(s / 3600)).padStart(2, '0') + ':' +\n                  String(Math.floor(s / 60) % 60).padStart(2, '0');\nlet stop = null;\n\nif (p.state !== last.state) {\n    if (last.state !== 'RUNNING') {                          // a stop just ended\n        stop = { payload: {\n            start:   hhmm(last.since),\n            end:     hhmm(clock),\n            minutes: Math.round((clock - last.since) / 6) / 10,\n            state:   last.state,\n            reason:  last.reason,\n            type:    bucket(last.state)\n        }};\n        log = [stop.payload, ...log].slice(0, 50);           // newest first\n    }\n    last = { state: p.state, reason: p.reason, since: clock };\n}\nlast.hb = p.heartbeat;\n\ncontext.set('last', last);\ncontext.set('clock', clock);\ncontext.set('totals', totals);\ncontext.set('log', log);\n\nconst live = { payload: { ...p, clock: hhmm(clock), totals: {\n    run:       Math.round(totals.run / 60),\n    planned:   Math.round(totals.planned / 60),\n    unplanned: Math.round(totals.unplanned / 60)\n}}};\nreturn [live, stop, stop ? { payload: log } : null];\n",
  "outputs": 3,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "outputLabels": [
   "live status",
   "finished stop",
   "stop log (newest first)"
  ],
  "x": 600,
  "y": 120,
  "wires": [
   [
    "fm02000d"
   ],
   [
    "fm020005",
    "fm020007"
   ],
   [
    "fm02000e"
   ]
  ]
 },
 {
  "id": "fm020005",
  "type": "function",
  "z": "fm020000",
  "name": "To CSV line",
  "func": "// One CSV line per stop; writes the header once when the file is new.\nconst s = msg.payload;\nconst file = env.get('STOPS_FILE') || 'stops.csv';\nlet line = [s.start, s.end, s.minutes, s.state, s.reason, s.type].join(',');\nif (!fs.existsSync(file)) line = 'start,end,minutes,state,reason,type\\n' + line;\nmsg.filename = file;\nmsg.payload = line;\nreturn msg;\n",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [
   {
    "var": "fs",
    "module": "fs"
   }
  ],
  "x": 830,
  "y": 220,
  "wires": [
   [
    "fm020006"
   ]
  ]
 },
