 {
  "id": "fm02000d",
  "type": "ui-template",
  "z": "fm020000",
  "group": "fm02000b",
  "page": "",
  "ui": "",
  "name": "Status card",
  "order": 1,
  "width": "12",
  "height": "5",
  "head": "",
  "format": "<template>\n  <div class=\"m\" v-if=\"msg && msg.payload\">\n    <div class=\"top\">\n      <div class=\"state\" :style=\"{ background: color }\">{{ msg.payload.state }}</div>\n      <div class=\"reason\">{{ msg.payload.reason === '-' ? '' : msg.payload.reason }}</div>\n      <div class=\"clock\">machine time {{ msg.payload.clock }}</div>\n    </div>\n    <div class=\"row\">\n      <div class=\"kpi\"><span>GOOD</span><b>{{ fmt(msg.payload.good) }}</b></div>\n      <div class=\"kpi\"><span>SCRAP</span><b class=\"bad\">{{ fmt(msg.payload.scrap) }}</b></div>\n      <div class=\"kpi\"><span>CYCLE</span><b>{{ msg.payload.cycle.toFixed(1) }} s</b></div>\n      <div class=\"kpi\"><span>MOTOR</span><b>{{ msg.payload.temp.toFixed(1) }} \u00b0C</b></div>\n    </div>\n    <div class=\"bar\">\n      <div class=\"seg run\" :style=\"{ flex: msg.payload.totals.run || 0.0001 }\"></div>\n      <div class=\"seg pl\" :style=\"{ flex: msg.payload.totals.planned }\"></div>\n      <div class=\"seg un\" :style=\"{ flex: msg.payload.totals.unplanned }\"></div>\n    </div>\n    <div class=\"legend\">\n      <span><i class=\"run\"></i>Running {{ msg.payload.totals.run }} min</span>\n      <span><i class=\"pl\"></i>Planned stops {{ msg.payload.totals.planned }} min</span>\n      <span><i class=\"un\"></i>Unplanned stops {{ msg.payload.totals.unplanned }} min</span>\n    </div>\n  </div>\n  <div v-else class=\"wait\">Waiting for the machine\u2026</div>\n</template>\n\n<script>\nexport default {\n  methods: { fmt(n) { return Number(n).toLocaleString('en-US') } },\n  computed: {\n    color() {\n      const s = this.msg?.payload?.state\n      if (s === 'RUNNING') return '#2E9E6A'\n      if (s === 'CHANGEOVER' || s === 'PLANNED_STOP') return '#5C6675'\n      if (s === 'IDLE') return '#C9861C'\n      return '#D0393F'\n    }\n  }\n}\n</script>\n\n<style scoped>\n.m { font-family: Inter, system-ui, sans-serif; color: #F2EFE9; padding: 8px 4px; }\n.top { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }\n.state { font-size: 34px; font-weight: 800; letter-spacing: 1px; padding: 8px 18px; border-radius: 10px; }\n.reason { font-size: 24px; color: #F5B342; }\n.clock { margin-left: auto; font-family: 'JetBrains Mono', monospace; color: #A8B0BA; font-size: 18px; }\n.row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 18px 0; }\n.kpi { background: #1B1F24; border-radius: 10px; padding: 12px 14px; display: flex; flex-direction: column; gap: 4px; }\n.kpi span { font-size: 13px; letter-spacing: 2px; color: #A8B0BA; font-weight: 700; }\n.kpi b { font-size: 30px; font-family: 'JetBrains Mono', monospace; }\n.kpi b.bad { color: #E5484D; }\n.bar { display: flex; height: 22px; border-radius: 6px; overflow: hidden; background: #1B1F24; }\n.seg.run, i.run { background: #2E9E6A; } .seg.pl, i.pl { background: #5C6675; } .seg.un, i.un { background: #D0393F; }\n.legend { display: flex; gap: 22px; margin-top: 10px; font-size: 16px; color: #C9CED6; flex-wrap: wrap; }\n.legend i { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }\n.wait { color: #A8B0BA; font-size: 20px; padding: 20px; }\n</style>\n",
  "storeOutMessages": true,
  "passthru": false,
  "resendOnRefresh": true,
  "templateScope": "local",
  "className": "",
  "x": 830,
  "y": 100,
  "wires": [
   []
  ]
