 "title": "Factory Monitoring – OEE (fed by an ESP32, Wokwi Episode 7)",
 "uid": "wk07-oee",
 "tags": [
  "factory-monitoring",
  "oee",
  "esp32",
  "wokwi",
  "chinarsoft"
 ],
 "timezone": "browser",
 "editable": true,
