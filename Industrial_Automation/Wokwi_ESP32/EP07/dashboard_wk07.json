    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${DS_INFLUX}"
     },
     "rawSql": "SELECT time, state\nFROM machine\nWHERE $__timeFilter(time)\nORDER BY time",
     "rawQuery": true,
     "format": "time_series",
     "dataset": "iox",
     "table": "",
     "sql": {}
    }
   ],
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed"
     },
     "custom": {
      "fillOpacity": 85,
      "lineWidth": 0,
      "insertNulls": 15000,
      "spanNulls": false
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "RUNNING": {
         "color": "#3FB97E",
         "index": 0,
         "text": "RUNNING"
        },
        "IDLE": {
         "color": "#E8B339",
         "index": 1,
         "text": "IDLE"
        },
        "FAULT": {
         "color": "#E5484D",
         "index": 2,
         "text": "FAULT"
        },
        "CHANGEOVER": {
         "color": "#6B7280",
         "index": 3,
         "text": "CHANGEOVER"
        },
        "PLANNED_STOP": {
         "color": "#6B7280",
         "index": 4,
         "text": "PLANNED_STOP"
        },
        "STOPPED": {
         "color": "#6B7280",
         "index": 5,
