         "fixedColor": "#6B7280"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "unplanned"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#E5484D"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "reduceOptions": {
     "calcs": [],
     "fields": "/^minutes$/",
     "values": true
