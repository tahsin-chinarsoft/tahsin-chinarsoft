  {
   "type": "bargauge",
   "title": "Where the shift went (minutes)",
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${DS_INFLUX}"
     },
     "rawSql": "SELECT bucket, ROUND(SUM(dt) / 60.0, 1) AS minutes\nFROM machine\nWHERE $__timeFilter(time)\nGROUP BY bucket\nORDER BY bucket DESC",
     "rawQuery": true,
     "format": "table",
     "dataset": "iox",
     "table": "",
     "sql": {}
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "suffix: min",
     "decimals": 1,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#3FB97E"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "run"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3FB97E"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "planned"
      },
      "properties": [
       {
        "id": "color",
        "value": {
