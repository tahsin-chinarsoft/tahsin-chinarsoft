     "rawSql": "SELECT\n  SUM(run_s) / (SUM(run_s) + SUM(unplanned_s))   AS availability,\n  2.0 * SUM(parts) / SUM(run_s)                  AS performance,\n  SUM(good) / SUM(parts)                         AS quality,\n  SUM(run_s) / (SUM(run_s) + SUM(unplanned_s)) * 2.0 * SUM(parts) / SUM(run_s) * SUM(good) / SUM(parts) AS oee\nFROM (\n  SELECT device,\n    SUM(CASE WHEN bucket = 'run'       THEN dt ELSE 0 END) * 1.0 AS run_s,\n    SUM(CASE WHEN bucket = 'unplanned' THEN dt ELSE 0 END) * 1.0 AS unplanned_s,\n    (MAX(good) - MIN(good) + MAX(scrap) - MIN(scrap)) * 1.0      AS parts,\n    (MAX(good) - MIN(good)) * 1.0                                AS good\n  FROM machine\n  WHERE $__timeFilter(time) AND device IN (${device:singlequote})\n  GROUP BY device\n)",
     "rawQuery": true,
     "format": "table",
     "dataset": "iox",
     "table": "",
     "sql": {}
    }
