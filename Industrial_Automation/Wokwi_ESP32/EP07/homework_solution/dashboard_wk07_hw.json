  {
   "id": 99,
   "type": "table",
   "title": "Compare machines (OEE = A × P × Q)",
   "datasource": {
    "type": "influxdb",
    "uid": "${DS_INFLUX}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "${DS_INFLUX}"
     },
     "rawSql": "SELECT device,\n  run_s / (run_s + unplanned_s) * 2.0 * parts / run_s * good / parts AS oee,\n  run_s / (run_s + unplanned_s) AS availability,\n  2.0 * parts / run_s AS performance,\n  good / parts AS quality\nFROM (\n  SELECT device,\n    SUM(CASE WHEN bucket = 'run'       THEN dt ELSE 0 END) * 1.0 AS run_s,\n    SUM(CASE WHEN bucket = 'unplanned' THEN dt ELSE 0 END) * 1.0 AS unplanned_s,\n    (MAX(good) - MIN(good) + MAX(scrap) - MIN(scrap)) * 1.0      AS parts,\n    (MAX(good) - MIN(good)) * 1.0                                AS good\n  FROM machine\n  WHERE $__timeFilter(time) AND device IN (${device:singlequote})\n  GROUP BY device\n)\nORDER BY device",
     "rawQuery": true,
     "format": "table",
     "dataset": "iox",
     "table": "",
     "sql": {}
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#E5484D",
        "value": null
       },
       {
        "color": "#F28C28",
        "value": 0.6
       },
       {
        "color": "#3FB97E",
        "value": 0.85
       }
      ]
     },
     "custom": {
      "cellOptions": {
       "type": "color-text"
      },
      "align": "center"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "device"
      },
      "properties": [
       {
        "id": "unit",
        "value": "string"
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "auto"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "oee"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "gauge",
         "mode": "basic"
        }
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 1
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "lg"
   }
