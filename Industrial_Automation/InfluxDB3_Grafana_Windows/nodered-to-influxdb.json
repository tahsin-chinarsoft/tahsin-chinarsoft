[
  {
    "id": "influx_in",
    "type": "mqtt in",
    "z": "mqttlab_tab",
    "name": "",
    "topic": "factory/line1/data",
    "qos": "0",
    "datatype": "json",
    "broker": "mqttlab_broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 360,
    "wires": [
      [
        "influx_lp"
      ]
    ]
  },
  {
    "id": "influx_lp",
    "type": "function",
    "z": "mqttlab_tab",
    "name": "to line protocol",
    "func": "const p = msg.payload;\nmsg.headers = { Authorization: \"Bearer \" + env.get(\"INFLUXDB3_AUTH_TOKEN\"), \"Content-Type\": \"text/plain\" };\nmsg.payload = `machine,line=line1 temp=${p.temp},parts=${p.parts}i,state=\"${p.state}\" ${p.ts}`;\nreturn msg;",
    "outputs": 1,
    "x": 370,
    "y": 360,
    "wires": [
      [
        "influx_http"
      ]
    ]
  },
  {
    "id": "influx_http",
    "type": "http request",
    "z": "mqttlab_tab",
    "name": "write to InfluxDB 3",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "http://127.0.0.1:8181/api/v3/write_lp?db=factory&precision=ms",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 600,
    "y": 360,
    "wires": [
      [
        "influx_dbg"
      ]
    ]
  },
  {
    "id": "influx_dbg",
    "type": "debug",
    "z": "mqttlab_tab",
    "name": "write status",
    "active": true,
    "tosidebar": true,
    "complete": "statusCode",
    "targetType": "msg",
    "x": 810,
    "y": 360,
    "wires": []
  }
]